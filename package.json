{
  "name": "collabagent",
  "private": true,
  "description": "AI-native team collaboration platform — where agents are teammates, not tools",
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "audit:bcrypt-tokens": "node scripts/audit-bcrypt-tokens.mjs",
    "validate:compose": "node scripts/validate-compose.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "lefthook": "^2.1.10"
  }
}
