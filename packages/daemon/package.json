{
  "name": "@collabagent/daemon",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "collabagent-daemon": "./dist-bundle/daemon.cjs",
    "slock": "./dist-bundle/cli.cjs"
  },
  "files": [
    "dist-bundle",
    "schemas"
  ],
  "scripts": {
    "dev": "tsx src/supervisor.ts",
    "dev:once": "tsx src/index.ts",
    "serve": "tsx src/supervisor.ts",
    "computer": "tsx src/cli.ts computer",
    "build": "tsc",
    "build:dist": "node scripts/build-dist.mjs",
    "pack:dist": "node scripts/pack-dist.mjs",
    "prepack": "node scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@collabagent/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/headless": "^6.0.0",
    "commander": "^12.1.0",
    "dotenv": "^17.4.2",
    "fflate": "0.8.3",
    "undici": "^7.29.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
