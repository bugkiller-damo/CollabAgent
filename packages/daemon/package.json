{
  "name": "@collabagent/daemon",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "collabagent-daemon": "./dist-bundle/daemon.cjs",
    "slock": "./dist-bundle/cli.cjs"
  },
  "files": [
    "dist-bundle",
    "schemas"
  ],
  "scripts": {
    "dev": "tsx src/supervisor.ts",
    "dev:once": "tsx src/index.ts",
    "serve": "tsx src/supervisor.ts",
    "computer": "tsx src/cli.ts computer",
    "build": "tsc",
    "build:dist": "node scripts/build-dist.mjs",
    "pack:dist": "node scripts/pack-dist.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "prepack": "node scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@collabagent/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/headless": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "fflate": "0.8.3",
    "undici": "^8.12.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
